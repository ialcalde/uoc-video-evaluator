# Copy this file to .env and fill in your API keys

# ── AI providers ──────────────────────────────────────────────────────────────

# Anthropic Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model (can also use --model on the CLI).
# Default: claude-opus-4-7
# ANTHROPIC_MODEL=claude-opus-4-7

# OpenAI Whisper (audio transcription) — https://platform.openai.com/
OPENAI_API_KEY=sk-...

# ── Google Drive (optional) ───────────────────────────────────────────────────
# Required only when using --drive-folder or GOOGLE_DRIVE_FOLDER_ID.
#
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth2 client → Application type: "Desktop app"
# 3. Download the JSON and copy client_id / client_secret below.
# 4. Enable the Google Drive API at:
#    https://console.cloud.google.com/apis/library/drive.googleapis.com

GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ID of the Drive folder containing student videos.
# Find it in the folder's URL: drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=
